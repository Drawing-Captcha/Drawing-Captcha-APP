<!DOCTYPE html>
<html data-wf-page="66169709aa43003e0240322d">

<head>
  <meta charset="utf-8">
  <title>Login | Drawing-Captcha</title>
  <meta name="robots" content="noindex">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <link href="images/favicon.ico" rel="shortcut icon" type="image/x-icon">
  <link href="css/normalize.css" rel="stylesheet" type="text/css">
  <link href="css/webflow.css" rel="stylesheet" type="text/css">
  <link href="css/login.css" rel="stylesheet" type="text/css">
  <link rel="stylesheet" href="css/signUpButtons.css" type="text/css">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous">
  <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
  <script src="js/loadWebFont.js"></script>
  <link href="images/favicon.ico" rel="shortcut icon" type="image/x-icon">
  <link href="images/favicon.ico" rel="apple-touch-icon">
</head>
<body>
  <section class="section">
    <div class="left">
      <a href="#" class="logo-link w-inline-block"><img src="images/drawing-Captcha_small.png" loading="lazy"
          width="217" alt=""></a>
      <div class="left-wrap">
        <h1>Drawing Captcha Alpha</h1>
        <p class="header-p">Draw your own Captcha and make the validation from now on easier! 🚀</p>
      </div><img src="images/shots.png" loading="lazy" sizes="(max-width: 991px) 90vw, 40vw"
        srcset="images/shots.png 500w, images/shots.png 800w, images/shots.png 1080w, images/shots.png 1600w, images/shots.png 1616w"
        alt="" class="left-img">
    </div>
    <div class="right">
      <div class="right-wrap">
        <h2>Welcome back👋 Log in</h2>
        <div class="form-block w-form">
          <% if (basicAuth===true) { %>
            <form id="email-form" name="email-form" data-name="Email Form" action="/auth/login" method="post"
              data-ms-form="login" class="form" data-wf-page-id="6659b8e5d8d82b64170d269f"
              data-wf-element-id="bba2c9ab-7750-79cf-2e09-2f56d815d61d">
              <div class="firm-fields"><label for="Email" class="text-field">Email address</label><input
                  class="field-label w-input" maxlength="256" name="email" data-name="Email"
                  placeholder="john@gmail.com" type="email" id="Email" data-ms-member="email"></div>
              <div class="firm-fields"><label for="Password" class="text-field">Password</label>
                <div class="pw-switch"><input class="field-label password w-input" maxlength="256" name="password"
                    data-name="Password" placeholder="**********" type="password" id="password"
                    data-ms-member="password">
                  <div class="eyes-wrap"><img src="images/open-eye.svg" loading="lazy" style="display:block"
                      data-w-id="0b2ca6f0-3b5e-f30a-47b6-bec666e52d05" id="eye-open" alt="" class="eye-open"><img
                      src="images/closed-eye.svg" loading="lazy" data-w-id="083f0822-70df-2ce1-3e00-f1ab8ba79da6" alt=""
                      id="eye-close" class="eye-close"></div>
                </div>
              </div><input type="submit" data-wait="Please wait..." class="button w-button" value="Sign in">
              <div class="link-wrap">
                <p class="grey-p">Don&#x27;t have an account? <a href="/register" class="sign-in_link">Sign up</a>
                </p>
              </div>
            </form>
            <% } %>
              <% if (divider===true) { %>
                <div class="divider">or</div>
                <% } %>
                  <div class="oauth-buttons">
                    <% if (googleSignUp===true) { %>
                      <a href="/api/auth/google" class="gsi-material-button"
                        style="width:400; text-decoration: none;">
                        <div class="gsi-material-button-state"></div>
                        <div class="gsi-material-button-content-wrapper">
                          <div class="gsi-material-button-icon">
                            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"
                              xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;">
                              <path fill="#EA4335"
                                d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z">
                              </path>
                              <path fill="#4285F4"
                                d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z">
                              </path>
                              <path fill="#FBBC05"
                                d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z">
                              </path>
                              <path fill="#34A853"
                                d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z">
                              </path>
                              <path fill="none" d="M0 0h48v48H0z"></path>
                            </svg>
                          </div>
                          <span class="gsi-material-button-contents">Sign in with Google</span>
                          <span style="display: none;">Sign in with Google</span>
                        </div>
                      </button>
                      <% } %>
                        <% if (msSignUp===true) { %>
                          <a href="/api/auth/microsoft" class="ms-btn">
                            <img src="images/Microsoft_logo.svg" loading="lazy" alt="Microsoft Logo">
                            Sign in with Microsoft
                          </a>
                          <% } %>
                  </div>
                  <% if (message && isSuccessfull) { %>
                    <div class="success-message">
                      <div>
                        <%= message %>!
                      </div>
                    </div>
                    <% } else if (message) { %>
                      <div class="w-form-fail">
                        <div>
                          <%= message %>
                        </div>
                        <% if (resendConfirmEmail) { %>
                          <a style="color: white;" href='/resendEmailVerification'>Resend confirmation email</a>
                          <% } %>
                      </div>
                      <% } %>
                        <% if (error==='auth_conflict' ) { %>
                          <div class="w-form-fail">
                            This email is already registered with a different sign-in method. Please use that to log in.
                          </div>
                          <% } %>
        </div>
      </div>
    </div>
  </section>
</body>
</html>