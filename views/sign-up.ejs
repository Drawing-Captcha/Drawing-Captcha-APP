<!DOCTYPE html>
<html data-wf-page="66169709aa43003e0240322d" >
<head>
  <meta charset="utf-8">
  <title>Sign Up | Drawing-Captcha</title>
  <meta name="robots" content="noindex">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <link href="css/normalize.css" rel="stylesheet" type="text/css">
  <link href="css/webflow.css" rel="stylesheet" type="text/css">
  <link href="css/login.css" rel="stylesheet" type="text/css">
  <link rel="stylesheet" href="css/signUpButtons.css" type="text/css">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous">
  <link href="images/favicon.ico" rel="shortcut icon" type="image/x-icon">
  <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
  <script type="text/javascript">WebFont.load({  google: {    families: ["Poppins:regular,500,600,700","Outfit:100,200,300,regular,500,600,700,800,900"]  }});</script>
  <!-- <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script> -->
  <link href="images/favicon.ico" rel="shortcut icon" type="image/x-icon">
  <link href="images/favicon.ico" rel="apple-touch-icon">
</head>
<body>
  <section class="section">
    <div class="left">
      <a href="#" class="logo-link w-inline-block"><img src="images/drawing-Captcha_small.png" loading="lazy" width="217" alt=""></a>
      <div class="left-wrap">
        <h1>Drawing Captcha Alpha</h1>
        <p class="header-p">Draw your own Captcha and make the validation from now on easier! 🚀</p>
      </div><img src="images/shots.png" loading="lazy" sizes="(max-width: 991px) 90vw, 40vw" srcset="images/shots.png 500w, images/shots.png 800w, images/shots.png 1080w, images/shots.png 1600w, images/shots.png 1616w" alt="" class="left-img">
    </div>
    <div class="right">
      <div class="right-wrap">
        <h2>Sign up</h2>
        <div class="form-block w-form">
          <% if (basicAuth) { %>
          <form action="/auth/register" id="email-form" name="email-form" data-name="Email Form" method="post" data-ms-form="signup" class="form" data-wf-page-id="6659b8e5d8d82b64170d26a1" data-wf-element-id="bba2c9ab-7750-79cf-2e09-2f56d815d61d">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
            <div class="firm-fields"><label for="Name" class="text-field">Full name</label><input class="field-label name w-input" maxlength="256" name="username" data-name="Name" placeholder="Enter your name" type="text" id="Name" data-ms-member="full-name" required></div>
            <div class="firm-fields"><label for="Name-2" class="text-field">Register Key</label><input class="field-label name w-input" maxlength="256" name="registerKey" data-name="Name 2" placeholder="Enter the register key" type="password" id="Name-2" data-ms-member="full-name" required></div>
            <div class="firm-fields"><label for="Email" class="text-field">Email address</label><input class="field-label w-input" maxlength="256" name="email" data-name="Email" placeholder="Enter your email adress" type="email" id="Email" data-ms-member="email" required></div>
            <div class="firm-fields">
              <label for="Password" class="text-field">Password</label>
              <div class="pw-switch">
                <input class="field-label password w-input" maxlength="256" name="password" data-name="Password" placeholder="**********" type="password" id="password" data-ms-member="email" required>
                <div class="eyes-wrap">
                  <img src="images/open-eye.svg" loading="lazy" style="display:block" data-w-id="0ced9f40-a6ef-8912-aaab-180d373e00ce" id="eye-open" alt="" class="eye-open">
                  <img src="images/closed-eye.svg" loading="lazy" data-w-id="0ced9f40-a6ef-8912-aaab-180d373e00cf" alt="" id="eye-close" class="eye-close">
                </div>
              </div>
              <div id="password-strength" class="password-strength" style="margin-top: 10px;">Password Strength: </div>
            </div>
            <input type="submit" data-wait="Please wait..." class="button w-button" value="Sign up">
            <div class="link-wrap">
              <p class="grey-p">Have an account? <a href="/login" class="sign-in_link">Sign in</a>
              </p>
            </div>
          </form>
          <% } %>
          <% if (divider) { %>
            <div class="divider">or</div>
            <% } %>
            <div class="oauth-buttons">
              <% if (googleSignUp) { %>
              <button onclick="window.location.href='/api/auth/google'" class="gsi-material-button" style="width:400">
                <div class="gsi-material-button-state"></div>
                <div class="gsi-material-button-content-wrapper">
                  <div class="gsi-material-button-icon">
                    <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"
                      xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;">
                      <path fill="#EA4335"
                        d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z">
                      </path>
                      <path fill="#4285F4"
                        d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z">
                      </path>
                      <path fill="#FBBC05"
                        d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z">
                      </path>
                      <path fill="#34A853"
                        d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z">
                      </path>
                      <path fill="none" d="M0 0h48v48H0z"></path>
                    </svg>
                  </div>
                  <span class="gsi-material-button-contents">Sign up with Google</span>
                  <span style="display: none;">Sign up with Google</span>
                </div>
              </button>
              <% } %>
              <% if (msSignUp) { %>
              <a href="/api/auth/microsoft" class="ms-btn">
                  <img src="images/Microsoft_logo.svg" loading="lazy"
                  alt="Microsoft Logo">
                Sign in with Microsoft
              </a>
              <% } %>
            </div>
          <% if (RegisterMessage && isSuccessfull) { %>
          <div class="success-message">
            <div><%= RegisterMessage %>!</div>
          </div>
          <% } else if (RegisterMessage) { %>
            <div class="w-form-fail">
              <div><%= RegisterMessage %></div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>
  <!-- <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6659b8e4d8d82b64170d265c" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script> -->
  <!-- <script src="js/webflow.js" type="text/javascript"></script> -->
   <script src="/js/signup.js"></script>
</body>
</html>